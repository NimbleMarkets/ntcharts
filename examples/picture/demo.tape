# NOTE: we actually hand-make this GIF because the Kitty Graphics do not render in VHS

Output demo.gif

Require echo

Set Shell "bash"
Set Padding 0
Set Framerate 10
Set PlaybackSpeed 1.0
Set FontSize 4
Set Width 640
Set Height 480

Hide
Type "./bin/ntcharts-picture"
Enter
Show

Sleep 1.5s
Type "g"

Sleep 1.5s
Type "g"

Hide
Type "q"
