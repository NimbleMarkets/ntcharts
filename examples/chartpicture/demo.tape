# NOTE: we actually hand-make this GIF because the Kitty Graphics do not render in VHS

Output demo.gif

Require echo

Set Shell "bash"
Set Padding 0
Set Framerate 10
Set PlaybackSpeed 1.0
Set FontSize 4
Set Width 640
Set Height 480

Hide
Type "./bin/ntcharts-chartpicture"
Enter
Show

Sleep 2s
Type "g"

Sleep 2s
Type "r"

Sleep 2s
Type "g"

Sleep 2s
Type "r"

Sleep 3s
Type "g"

Hide
Type "q"
