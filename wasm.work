// Workspace used only by cmd/wasm-build to compile the showcase demos
// for GOOS=js/GOARCH=wasm. The bubbletea fork adds js/wasm and wasip1
// build stubs; drop this file's replace and use go.work everywhere once
// https://github.com/charmbracelet/bubbletea/pull/1693 merges upstream.

go 1.26.8

use (
	.
	./cmd
	./examples
	./examples/shaders
	./picture/chartpicture
	./spec/echarts
)

replace charm.land/bubbletea/v2 => github.com/neomantra/bubbletea/v2 v2.0.0-20260928192001-1b36865b418a

replace github.com/NimbleMarkets/ntcharts/spec/echarts/v2 v2.5.0 => ./spec/echarts

replace github.com/NimbleMarkets/ntcharts/v2 v2.5.0 => .

replace github.com/NimbleMarkets/ntcharts/picture/chartpicture/v2 v2.5.0 => ./picture/chartpicture
