<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ .Demo.Title }} — ntcharts</title>
<link rel="icon" type="image/svg+xml" href="/ntcharts/_assets/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans+Condensed:wght@700&family=Open+Sans:wdth,wght@87.5,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/ntcharts/style.css">
</head>
<body class="layout">
<button class="menu-button" aria-label="Toggle navigation">☰</button>
<div class="sidebar-overlay"></div>
{{ template "sidebar" . }}
<main class="main">
  <header class="demo-header">
    <h1>{{ .Demo.Title }}</h1>
    <p class="demo-blurb">{{ .Demo.Blurb }}</p>
    <a class="demo-source-link" href="https://github.com/NimbleMarkets/ntcharts/tree/v2/{{ trimPrefix .Demo.Source `./` }}">
      Source on GitHub →
    </a>
  </header>
  <section class="terminal-frame">
    <div id="terminal"></div>
  </section>
</main>
<script src="/ntcharts/_assets/wasm_exec.js"></script>
<script type="module">
  // Mirrors the booba reference index.html: instantiate the Go WASM runtime
  // with this demo's app.wasm, then mount a BoobaTerminal on the container.
  // installRendererHud/parseRendererFromURL are re-exported by booba from
  // ghostty-web — the renderer HUD source lives upstream now (cycles
  // webgpu → webgl → canvas2d, uses e.code so the macOS Option dead-key
  // transform doesn't break the hotkey).
  import {
    BoobaTerminal,
    installRendererHud,
    parseRendererFromURL,
  } from "/ntcharts/_assets/booba/booba.js";

  async function main() {
    const go = new Go();
    const result = await WebAssembly.instantiateStreaming(
      fetch("./app.wasm"), go.importObject
    );
    go.run(result.instance);

    const booba = new BoobaTerminal("terminal", {
      renderer: parseRendererFromURL(),
    });
    await booba.init();
    booba.connectWasm();
    booba.focus();

    const frame = document.querySelector(".terminal-frame");
    installRendererHud(booba.term, {
      parent: frame ?? undefined,
      position: "absolute",
      className: "demo-renderer-hud",
      // Demo embedders own keyboard UX; click-to-toggle is enough.
      bindToggleHotkey: false,
    });
  }

  main().catch(console.error);
</script>
<script>
(function() {
  const menuButton = document.querySelector('.menu-button');
  const sidebar = document.querySelector('.sidebar');
  const overlay = document.querySelector('.sidebar-overlay');

  function toggleMenu() {
    sidebar.classList.toggle('open');
    overlay.classList.toggle('open');
    menuButton.textContent = sidebar.classList.contains('open') ? '×' : '☰';
  }

  function closeMenu() {
    sidebar.classList.remove('open');
    overlay.classList.remove('open');
    menuButton.textContent = '☰';
  }

  menuButton.addEventListener('click', toggleMenu);
  overlay.addEventListener('click', toggleMenu);
  document.querySelectorAll('.sidebar-link').forEach(link => {
    link.addEventListener('click', closeMenu);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
})();
</script>
</body>
</html>
